# DB_BACKEND=sqlite | db2
DB_BACKEND=sqlite
SQLITE_PATH=data/wildfire.db
# Db2 for z/OS (only if DB_BACKEND=db2)
DB2_DSN=DATABASE=WILDFIRE;HOSTNAME=your.zos.host;PORT=446;PROTOCOL=TCPIP;UID=user;PWD=pass;
# Optional watsonx.ai explainer
USE_WATSONX=false
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
# Synthetic-data knobs (planted bias the audit must recover)
INCOME_PENALTY_PREMIUM=0.15
INCOME_PENALTY_NONRENEWAL=0.50
